# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_NAME=CorePath Knowledge API
LOG_LEVEL=INFO

# Example only. Supply a real local or managed PostgreSQL connection string.
DATABASE_URL=postgresql://corepath:change-me@localhost:5432/corepath

# Temporary shared bearer token for internal source-registry routes.
# Use a long random value locally; production should move to per-service identities.
INTERNAL_API_TOKEN=replace-with-a-long-random-secret
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
