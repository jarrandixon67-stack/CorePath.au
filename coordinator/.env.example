# Example only. Supply real values through the deployment secret manager.
# Dedicated least-privilege login to the KNOWLEDGE database, never its owner.
COORDINATOR_DATABASE_URL=postgresql://coordinator_runtime:replace-me@localhost:5432/corepath_knowledge
# Incoming Personal AI capability verification (PUBLIC key only).
COORDINATOR_GATEWAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PUBLIC_KEY\n-----END PUBLIC KEY-----"
COORDINATOR_GATEWAY_ISSUER=corepath-service-gateway
COORDINATOR_GATEWAY_AUDIENCE=corepath-coordinator
# Must match the active coordinator service identity and exchanged token subject.
COORDINATOR_SERVICE_SUBJECT=corepath-coordinator
# Fixed trusted HTTPS services; operator-controlled, never selected by a model.
COORDINATOR_SPECIALIST_URL=https://specialists.example.invalid
COORDINATOR_EXCHANGE_URL=https://gateway.example.invalid/capabilities/exchange
COORDINATOR_EXCHANGE_TOKEN=replace-with-scoped-machine-credential
COORDINATOR_SPECIALIST_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_SPECIALIST_GATEWAY_PUBLIC_KEY\n-----END PUBLIC KEY-----"
COORDINATOR_SPECIALIST_ISSUER=corepath-service-gateway
COORDINATOR_SPECIALIST_AUDIENCE=corepath-specialists
COORDINATOR_OPENAI_API_KEY=replace-through-secret-manager
COORDINATOR_MODEL=replace-with-evaluated-model
COORDINATOR_MAX_OUTPUT_TOKENS=3000
COORDINATOR_MODEL_TIMEOUT_SECONDS=30
COORDINATOR_SPECIALIST_TIMEOUT_SECONDS=45
COORDINATOR_MAX_CONTEXT_CHARS=80000
# Capacity ceiling; requests default to four and may explicitly ask for up to nine.
# One Coordinator + nine specialists = ten bots total.
COORDINATOR_MAX_SPECIALIST_CALLS=9
COORDINATOR_MAX_RUNS_PER_24H=20
COORDINATOR_MAX_CONCURRENT_RUNS=1
COORDINATOR_MAX_DURATION_SECONDS=180
