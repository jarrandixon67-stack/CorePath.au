PARTNERS_ALLOWED_COUNTRIES=["AU"]
PARTNERS_ALLOWED_SECTORS=["health_and_wellbeing"]
PARTNERS_DAILY_EMAIL_LIMIT=10
PARTNERS_EMAIL_DELIVERY_ENABLED=false
PARTNERS_EMAIL_API_KEY=
PARTNERS_SENDER_EMAIL=
PARTNERS_SENDER_LEGAL_NAME=
PARTNERS_SENDER_CONTACT=
PARTNERS_REPLY_TO=
PARTNERS_PUBLIC_BASE_URL=
