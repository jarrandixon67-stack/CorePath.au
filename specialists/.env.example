# Example only. Set through the deployment secret manager; never commit real secrets.
# Use the KNOWLEDGE database with a dedicated least-privilege runtime account.
SPECIALISTS_DATABASE_URL=postgresql://specialist_runtime:replace-me@localhost:5432/corepath_knowledge
# Ed25519 PUBLIC key only. Private signing key stays in the trusted service gateway.
SPECIALISTS_GATEWAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_GATEWAY_PUBLIC_KEY\n-----END PUBLIC KEY-----"
SPECIALISTS_GATEWAY_ISSUER=corepath-service-gateway
SPECIALISTS_GATEWAY_AUDIENCE=corepath-specialists
SPECIALISTS_OPENAI_API_KEY=replace-through-secret-manager
# Select and evaluate a model supporting Responses API strict structured output.
SPECIALISTS_MODEL=replace-with-evaluated-model
# Optional JSON map of domain slug to model ID; all eleven otherwise share the default.
SPECIALISTS_MODEL_OVERRIDES={}
SPECIALISTS_MAX_OUTPUT_TOKENS=2400
SPECIALISTS_MODEL_TIMEOUT_SECONDS=30
SPECIALISTS_MAX_RUNS_PER_24H=20
SPECIALISTS_MAX_CONCURRENT_RUNS=2
SPECIALISTS_MAX_SOURCES=6
